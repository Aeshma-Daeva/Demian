---
import Base from '../../layouts/Base.astro';
import { getPublicPosts } from '../../lib/feeds';

const posts = await getPublicPosts();

const base = import.meta.env.BASE_URL;
---
<Base title="Log — Demian Lab">
  <style>
    h1 { font-size: 1.4rem; font-weight: 400; margin-bottom: 0.25rem; }
    .sub { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-bottom: 3rem; }

    .post-list { list-style: none; }

    .post-item {
      display: grid;
      grid-template-columns: 110px 1fr;
      gap: 1rem;
      padding: 1.1rem 0;
      border-bottom: 1px solid var(--border);
      align-items: start;
    }

    .post-date { font-family: var(--mono); font-size: 11px; color: var(--muted); padding-top: 3px; }
    .post-title { font-size: 0.95rem; }
    .post-title a { color: var(--text); }
    .post-title a:hover { color: var(--accent); text-decoration: none; }
    .post-desc { font-size: 0.85rem; color: var(--muted); margin-top: 4px; }
    .post-tags { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
    .tag { font-family: var(--mono); font-size: 10px; padding: 2px 6px; border: 1px solid var(--border); color: var(--muted); }
  </style>

  <h1>Research log</h1>
  <p class="sub">{posts.length} entries · demian-substrate eeg adaptation</p>

  <ul class="post-list">
    {posts.map(post => (
      <li class="post-item">
        <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
        <div>
          <p class="post-title"><a href={`${base}log/${post.slug}`}>{post.data.title}</a></p>
          {post.data.description && <p class="post-desc">{post.data.description}</p>}
          {post.data.tags && (
            <div class="post-tags">
              {post.data.tags.map((t: string) => <span class="tag">{t}</span>)}
            </div>
          )}
        </div>
      </li>
    ))}
  </ul>
</Base>
